let currentTabIndex = 0;
let currentTabs = [];

function render() {
  document.getElementById('navLogo').src = 'weblogo.png';

  const isAdmin = state.isAdmin;
  const tabs = isAdmin
    ? ['对阵表','积分榜','选手','规则','管理']
    : ['对阵表','积分榜','选手','规则'];

  const tabsChanged = JSON.stringify(tabs) !== JSON.stringify(currentTabs);
  if (tabsChanged) {
    currentTabs = [...tabs];
    currentTabIndex = 0;
    renderTabs(tabs);
  } else {
    refreshCurrentPanel(tabs);
  }

  renderRoundPill();
  document.getElementById('adminToggle').textContent = isAdmin ? '退出管理' : '管理';
}
function renderTabs(tabs) {
  const seg = document.getElementById('segCtrl');
  const slider = document.getElementById('segSlider');
  // Clear old buttons (keep slider)
  seg.querySelectorAll('.seg-btn').forEach(b=>b.remove());

  tabs.forEach((t,i) => {
    const btn = document.createElement('button');
    btn.className = 'seg-btn' + (i===currentTabIndex?' on':'');
    btn.textContent = t;
    btn.onclick = () => {
      currentTabIndex = i;
      switchTab(i, tabs);
    };
    seg.appendChild(btn);
  });

  slider.style.width = `calc(${100/tabs.length}% - ${(tabs.length-1)*2/tabs.length}px)`;
  if (currentTabIndex >= tabs.length) currentTabIndex = 0;
  switchTab(currentTabIndex, tabs);
}

function switchTab(idx, tabs) {
  currentTabIndex = idx;
  const btns = document.querySelectorAll('.seg-btn');
  btns.forEach((b,i) => b.className = 'seg-btn'+(i===idx?' on':''));
  const slider = document.getElementById('segSlider');
  slider.style.transform = `translateX(${idx*100}%)`;

  refreshCurrentPanel(tabs);
}

function refreshCurrentPanel(tabs) {
  const container = document.getElementById('panelContainer');
  const adminArea = document.getElementById('adminArea');
  container.innerHTML = '';
  adminArea.style.display = 'none';
  adminArea.innerHTML = '';

  const tabName = tabs[currentTabIndex];
  if (tabName==='对阵表') renderMatches(container);
  else if (tabName==='积分榜') renderRankings(container);
  else if (tabName==='选手') renderPlayers(container);
  else if (tabName==='规则') renderRules(container);
  else if (tabName==='管理') { adminArea.style.display='block'; renderAdmin(adminArea); }
}

function renderRoundPill() {
  const pill = document.getElementById('roundPill');
  if (!state.started || state.rounds.length===0) { pill.style.display='none'; return; }
  pill.style.display='flex';
  const r = state.rounds[state.rounds.length-1];
  const done = r.matches.filter(m=>m.result).length;
  document.getElementById('roundLabel').textContent = `第 ${r.number} 轮`;
  document.getElementById('roundMeta').textContent = `已完成 ${done} / ${r.matches.length} 场`;
}

function renderMatches(container) {
  if (!state.started) {
    container.innerHTML = '<div class="panel on"><div style="text-align:center;padding:60px 20px;color:var(--t3)">比赛尚未开始，请等待管理员编排</div></div>';
    return;
  }
  if (state.rounds.length===0) {
    container.innerHTML = '<div class="panel on"><div style="text-align:center;padding:60px 20px;color:var(--t3)">比赛尚未开始，请等待管理员编排</div></div>';
    return;
  }
  if (viewingRoundIdx !== null && viewingRoundIdx >= state.rounds.length) viewingRoundIdx = null;
  const ri = viewingRoundIdx !== null ? viewingRoundIdx : state.rounds.length - 1;
  const r = state.rounds[ri];
  const isLatestRound = ri === state.rounds.length - 1;

  const panel = document.createElement('div');
  panel.className = 'panel on';

  if (state.rounds.length > 1) {
    let roundSelector = '<div class="round-scroller" style="justify-content:center">';
    state.rounds.forEach((round, i) => {
      const isViewing = (viewingRoundIdx === null && i === state.rounds.length - 1) || (viewingRoundIdx === i);
      const style = isViewing
        ? 'background:var(--ice);color:var(--bg);font-weight:600'
        : 'background:rgba(255,255,255,0.06);color:var(--t2)';
      roundSelector += `<button type="button" onclick="viewRound(${i})" style="padding:6px 14px;border:none;border-radius:8px;font-size:13px;cursor:pointer;${style}">第${i + 1}轮</button>`;
    });
    roundSelector += '</div>';
    panel.innerHTML += roundSelector;
  }

  const pending = r.matches.filter(m => !m.result);
  const done = r.matches.filter(m => m.result);

  if (state.isAdmin && pending.length > 0 && done.length > 0) {
    panel.innerHTML += `<div style="text-align:center;padding:8px;color:var(--orange);font-size:13px;font-weight:500">还有 ${pending.length} 场比赛未录入成绩</div>`;
  }

  if (pending.length) {
    panel.innerHTML += `<div class="sec">正在进行</div>`;
    let cardHTML = '<div class="card">';
    pending.forEach((m, i) => { cardHTML += matchHTML(m, i, r); });
    cardHTML += '</div>';
    panel.innerHTML += cardHTML;
  }
  if (done.length) {
    panel.innerHTML += `<div class="sec">已完成</div>`;
    let cardHTML = '<div class="card">';
    done.forEach((m, i) => { cardHTML += matchHTML(m, pending.length + i, r); });
    cardHTML += '</div>';
    panel.innerHTML += cardHTML;
  }
  if (r.byes && r.byes.length) {
    const byeNames = r.byes.map(bid => getPlayerName(bid)).join('、');
    panel.innerHTML += `<div style="text-align:center;padding:16px;color:var(--t3);font-size:13px">本轮轮空：${byeNames}（各得 2 分）</div>`;
  }

  if (state.isAdmin && isLatestRound) {
    panel.innerHTML += `<div style="padding:12px 0 0"><button class="btn btn-secondary btn-block" onclick="exportPDF('matches')">导出当前对阵表 PDF</button></div>`;
    const allDone = r.matches.every(m => m.result);
    if (allDone && !r.confirmed) {
      const btnText = state.currentRound >= state.totalRounds
        ? '确认最终成绩（比赛结束）'
        : '确认成绩 & 生成第 ' + (state.currentRound + 1) + ' 轮编排';
      panel.innerHTML += `<div style="padding:12px 0"><button class="btn btn-success btn-block btn-lg" onclick="confirmRound()">${btnText}</button></div>`;
    } else if (r.confirmed && state.currentRound >= state.totalRounds) {
      panel.innerHTML += `<div style="text-align:center;padding:20px;color:var(--green);font-size:17px;font-weight:600">全部 ${state.totalRounds} 轮比赛已结束！</div>`;
    }
  }

  if (state.isAdmin) {
    panel.innerHTML += `<div style="padding:16px 0 8px"><button class="btn btn-primary btn-block" onclick="generateShareLink()">生成分享链接（发微信群）</button></div>`;
  }

  container.appendChild(panel);
}

function matchHTML(m, idx, round) {
  const nameA1 = getPlayerName(m.teamA[0]), nameA2 = getPlayerName(m.teamA[1]);
  const nameB1 = getPlayerName(m.teamB[0]), nameB2 = getPlayerName(m.teamB[1]);
  let tagText;
  if (m.result) {
    tagText = ICON.podium + ' 已结束';
  } else {
    tagText = state.isAdmin ? '待录入' : (ICON.ball + ' 进行中');
  }
  const tagClass = m.result ? 'tag-done' : (state.isAdmin ? 'tag-wait' : 'tag-live');
  const classA = m.result ? (m.result === 'A' ? 'W' : 'L') : 'P';
  const classB = m.result ? (m.result === 'B' ? 'W' : 'L') : 'P';
  let displayScoreA, displayScoreB;
  if (m.result) {
    displayScoreA = m.scoreA !== null && m.scoreA !== undefined ? m.scoreA : (m.result === 'A' ? '胜' : '负');
    displayScoreB = m.scoreB !== null && m.scoreB !== undefined ? m.scoreB : (m.result === 'B' ? '胜' : '负');
  } else {
    displayScoreA = '—';
    displayScoreB = '—';
  }
  const matchIdx = round.matches.indexOf(m);
  const roundIdx = round.number - 1;
  const courtLabel = /^\d+$/.test(String(m.table)) ? (ICON.court + ' ' + m.table + '号场地') : String(m.table);

  let actions = '';
  if (state.isAdmin && !round.confirmed) {
    if (!m.result) {
      actions = `<div class="score-input-row">
      <input type="number" class="score-input" id="sA_${roundIdx}_${matchIdx}" placeholder="0" min="0" max="99" step="1" inputmode="numeric" onkeypress="return event.charCode >= 48 && event.charCode <= 57">
      <span class="score-divider">:</span>
      <input type="number" class="score-input" id="sB_${roundIdx}_${matchIdx}" placeholder="0" min="0" max="99" step="1" inputmode="numeric" onkeypress="return event.charCode >= 48 && event.charCode <= 57">
      <button type="button" class="btn btn-primary" style="margin-left:8px;padding:10px 16px;font-size:14px" onclick="submitScore(${roundIdx},${matchIdx})">确认</button>
    </div>`;
    } else {
      actions = `<div class="match-actions">
        <button type="button" class="result-btn undo" onclick="clearResult(${roundIdx},${matchIdx})">撤销结果</button>
      </div>`;
    }
  }

  return `<div class="match">
