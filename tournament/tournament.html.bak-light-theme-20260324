// ═══════════════════════════════════════
// AUTH
// ═══════════════════════════════════════
function toggleAdmin() {
  if (state.isAdmin) {
    state.isAdmin = false;
    adminPassword = '';
    sessionStorage.removeItem('feiyang_admin_pwd');
    render();
    showToast('已退出管理模式');
  } else {
    document.getElementById('loginModal').classList.add('on');
    setTimeout(()=>document.getElementById('pwdInput').focus(), 100);
  }
}
async function doLogin() {
  const pwd = document.getElementById('pwdInput').value;
  try {
    const res = await fetch(API_BASE + '/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: pwd })
    });
    if (!res.ok) {
      document.getElementById('loginErr').style.display = 'block';
      return;
    }
    state.isAdmin = true;
    adminPassword = pwd;
    sessionStorage.setItem('feiyang_admin_pwd', pwd);
    document.getElementById('loginModal').classList.remove('on');
    document.getElementById('pwdInput').value = '';
    document.getElementById('loginErr').style.display = 'none';
    await loadState();
    if (state.players.length) nextId = Math.max(...state.players.map(p=>p.id), 0) + 1;
    render();
    showToast('已进入管理模式');
  } catch (e) {
    showToast('网络错误');
  }
}
function closeLogin() {
  document.getElementById('loginModal').classList.remove('on');
  document.getElementById('pwdInput').value = '';
  document.getElementById('loginErr').style.display = 'none';
}

// ═══════════════════════════════════════
// UTILS
// ═══════════════════════════════════════
function getPlayerName(id) {
  const p = state.players.find(x=>x.id===id);
  return p ? p.name : '???';
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 2000);
}

// Navbar scroll
let scrollTick = false;
window.addEventListener('scroll', () => {
  if (!scrollTick) {
    requestAnimationFrame(() => {
      document.getElementById('navbar').classList.toggle('scrolled', window.scrollY>16);
      scrollTick = false;
    });
    scrollTick = true;
  }
});

// ═══════════════════════════════════════
// INIT
// ═══════════════════════════════════════
async function restoreAdminFromSession() {
  if (location.hash.startsWith('#v=')) return;
  const savedPwd = sessionStorage.getItem('feiyang_admin_pwd');
  if (!savedPwd) return;
  try {
    const res = await fetch(API_BASE + '/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: savedPwd })
    });
    if (res.ok) {
      state.isAdmin = true;
      adminPassword = savedPwd;
    } else {
      sessionStorage.removeItem('feiyang_admin_pwd');
    }
  } catch (e) {}
}

async function init() {
  await loadState();
  loadFromHash();
  await restoreAdminFromSession();
  applyTestRosterIfEmpty();
  if (state.players.length) nextId = Math.max(...state.players.map(p=>p.id), 0) + 1;
  render();

  setInterval(async () => {
    if (!state.isAdmin) {
      const oldHash = getStateHash();
      await loadState();
      const newHash = getStateHash();
      if (newHash !== oldHash) {
        render();
      }
    }
  }, 15000);
}

init();
</script>
