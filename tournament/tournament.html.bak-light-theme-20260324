async function submitScore(roundIdx, matchIdx) {
  const inputA = document.getElementById('sA_' + roundIdx + '_' + matchIdx);
  const inputB = document.getElementById('sB_' + roundIdx + '_' + matchIdx);
  if (!inputA || !inputB) return;

  const valA = inputA.value.trim();
  const valB = inputB.value.trim();

  if (valA === '' || valB === '') {
    showToast('请输入双方比分');
    return;
  }

  const a = Number(valA);
  const b = Number(valB);
  if (!Number.isInteger(a) || !Number.isInteger(b)) {
    showToast('比分必须是整数');
    return;
  }

  if (a < 0 || b < 0) {
    showToast('比分不能为负数');
    return;
  }

  if (a === b) {
    showToast('比分不能相同，匹克球没有平局');
    return;
  }

  if (a > 30 || b > 30) {
    if (!confirm('比分超过30分，确定输入正确吗？(' + a + ':' + b + ')')) {
      return;
    }
  }

  const winScore = Math.max(a, b);
  if (winScore < 11) {
    if (!confirm('胜方得分低于11分，确定输入正确吗？(' + a + ':' + b + ')')) {
      return;
    }
  }

  const match = state.rounds[roundIdx].matches[matchIdx];
  match.scoreA = a;
  match.scoreB = b;
  match.result = a > b ? 'A' : 'B';
  await saveState();
  render();

  const winnerSide = a > b ? '左方' : '右方';
  showToast('已录入 ' + a + ' : ' + b + '（' + winnerSide + '胜）');
}

async function clearResult(roundIdx, matchIdx) {
  const match = state.rounds[roundIdx].matches[matchIdx];
  match.result = null;
  match.scoreA = null;
  match.scoreB = null;
  await saveState();
  render();
  showToast('已撤销结果');
}

async function confirmRound() {
  const r = state.rounds[state.rounds.length - 1];
  const unfinished = r.matches.filter(m => !m.result).length;
  if (unfinished > 0) {
    showToast('还有 ' + unfinished + ' 场比赛未录入成绩');
    return;
  }

  const isLastRound = state.currentRound >= state.totalRounds;
  const confirmMsg = isLastRound
    ? '确认本轮成绩？这是最后一轮，确认后比赛结束。'
    : '确认本轮成绩并生成第 ' + (state.currentRound + 1) + ' 轮编排？';

  if (!confirm(confirmMsg)) return;

  r.confirmed = true;
  await saveState();

  if (!isLastRound) {
    await generateRound();
    showToast('第 ' + state.currentRound + ' 轮已编排，请导出对阵表');
  } else {
    render();
    showToast('全部 ' + state.totalRounds + ' 轮比赛已结束！');
  }
}

