let nextId = 1;
async function addPlayer() {
  const input = document.getElementById('playerInput');
  const name = input.value.trim();
  if (!name) return;
  if (state.players.some(p=>p.name===name&&!p.retired)) { showToast('该选手已存在'); return; }
  state.players.push({ id: nextId++, name: name, retired: false });
  input.value = '';
  await saveState();
  render();
  showToast(`已添加：${name}`);
}

async function batchAdd() {
  const ta = document.getElementById('batchInput');
  const lines = ta.value.split('\n').map(l=>l.trim()).filter(l=>l);
  let count = 0;
  lines.forEach(name => {
    if (!state.players.some(p=>p.name===name&&!p.retired)) {
      state.players.push({ id: nextId++, name: name, retired: false });
      count++;
    }
  });
  ta.value = '';
  await saveState();
  render();
  showToast(`已批量添加 ${count} 名选手`);
}

async function removePlayer(id) {
  state.players = state.players.filter(p=>p.id!==id);
  await saveState();
  render();
}

async function retirePlayer() {
  const input = document.getElementById('retireInput');
  const name = input.value.trim();
  const p = state.players.find(x=>x.name===name&&!x.retired);
  if (!p) { showToast('未找到该选手'); return; }
  p.retired = true;
  input.value = '';
  await saveState();
  render();
  showToast(`${name} 已标记退赛`);
}

