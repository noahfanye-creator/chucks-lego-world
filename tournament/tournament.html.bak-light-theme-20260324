function exportPDF(type) {
  const printWindow = window.open('', '_blank');
  if (!printWindow) {
    showToast('请允许弹出窗口以导出 PDF');
    return;
  }
  const logo = document.getElementById('navLogo').src;
  let content = '';
  if (type === 'matches') {
    const ri = viewingRoundIdx !== null ? viewingRoundIdx : state.rounds.length - 1;
    content = generatePrintMatches(logo, ri);
  } else if (type === 'ranking') {
    content = generatePrintRanking(logo);
  } else {
    content = '<!DOCTYPE html><html><body>未知类型</body></html>';
  }
  printWindow.document.write(content);
  printWindow.document.close();
  printWindow.onload = function () {
    setTimeout(function () { printWindow.print(); }, 150);
  };
}

function generatePrintMatches(logo, roundIdx) {
  const r = state.rounds[roundIdx];
  if (!r) return '<!DOCTYPE html><html><body>暂无对阵数据</body></html>';

  let rows = '';
  r.matches.forEach((m, i) => {
    const nameA = getPlayerName(m.teamA[0]) + ' / ' + getPlayerName(m.teamA[1]);
    const nameB = getPlayerName(m.teamB[0]) + ' / ' + getPlayerName(m.teamB[1]);
    let scoreCell = '';
    if (m.result) {
      const sA = m.scoreA !== null && m.scoreA !== undefined ? m.scoreA : (m.result === 'A' ? '胜' : '负');
      const sB = m.scoreB !== null && m.scoreB !== undefined ? m.scoreB : (m.result === 'B' ? '胜' : '负');
      const winA = m.result === 'A';
      scoreCell = '<span style="font-weight:' + (winA ? '700' : '400') + ';color:' + (winA ? '#0D2137' : '#999') + '">' + sA + '</span>' +
        ' : ' +
        '<span style="font-weight:' + (!winA ? '700' : '400') + ';color:' + (!winA ? '#0D2137' : '#999') + '">' + sB + '</span>';
    } else {
      scoreCell = '<span style="color:#999">— : —</span>';
    }
    const status = m.result ? '已完成' : '正在进行';
    const statusColor = m.result ? '#248A3D' : '#FF9500';
    const courtLabel = /^\d+$/.test(String(m.table)) ? String(m.table) + '号场地' : String(m.table);
    rows += '<tr>' +
      '<td>' + (i + 1) + '</td>' +
      '<td>' + courtLabel + '</td>' +
      '<td style="text-align:left;font-weight:500;' + (m.result === 'A' ? '' : 'color:#666') + '">' + nameA + '</td>' +
      '<td>' + scoreCell + '</td>' +
      '<td style="text-align:left;font-weight:500;' + (m.result === 'B' ? '' : 'color:#666') + '">' + nameB + '</td>' +
      '<td style="color:' + statusColor + ';font-weight:600">' + status + '</td>' +
      '</tr>';
  });

  let byeInfo = '';
  if (r.byes && r.byes.length) {
    const byeNames = r.byes.map(bid => getPlayerName(bid)).join('、');
    byeInfo = '<div style="text-align:center;padding:12px;font-size:13px;color:#666">本轮轮空：' + byeNames + '（各得 2 分）</div>';
  }

  return generatePrintHTML(
    '第 ' + r.number + ' 轮 对阵表',
    logo,
    '<table>' +
    '<thead><tr><th style="width:6%">场次</th><th style="width:10%">场地</th><th style="width:26%;text-align:left">队伍 A</th><th style="width:14%">比分</th><th style="width:26%;text-align:left">队伍 B</th><th style="width:18%">状态</th></tr></thead>' +
    '<tbody>' + rows + '</tbody></table>' + byeInfo,
    '第 ' + r.number + ' 轮 / 共 ' + state.totalRounds + ' 轮'
  );
}

