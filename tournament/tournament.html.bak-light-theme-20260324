async function startTournament() {
  const nameEl = document.getElementById('tName');
  const dateEl = document.getElementById('tDate');
  const roundsEl = document.getElementById('tRounds');
  if (nameEl) state.tournamentName = nameEl.value || state.tournamentName;
  if (dateEl) state.date = dateEl.value || state.date;
  if (roundsEl) state.totalRounds = Math.min(12, Math.max(5, parseInt(roundsEl.value)||8));

  // Update title
  document.querySelector('.nav-large h1').textContent = state.tournamentName;

  state.started = true;
  nextId = Math.max(...state.players.map(p=>p.id), 0) + 1;
  await saveState();
  await generateRound();
  showToast('比赛开始！第 1 轮已编排');
}

async function resetTournament() {
  const input = prompt('此操作将清除所有比赛数据且不可恢复！\n\n请输入"确认重置"四个字来执行：');
  if (input !== '确认重置') {
    if (input !== null) showToast('输入不正确，未执行重置');
    return;
  }
  try {
    const res = await fetch(API_BASE + '/reset', {
      method: 'POST',
      headers: { 'X-Admin-Password': adminPassword }
    });
    if (!res.ok) { showToast('重置失败'); return; }
  } catch (e) {
    showToast('重置失败');
    return;
  }
  sessionStorage.removeItem('feiyang_admin_pwd');
  viewingRoundIdx = null;
  state = {
    tournamentName: '飞扬匹克内部循环赛', date: new Date().toISOString().slice(0,10),
    totalRounds: 8, players: [], rounds: [], currentRound: 0,
    started: false, isAdmin: state.isAdmin, partnerHistory: {}
  };
  nextId = 1;
  render();
  showToast('比赛已重置');
}

